generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  tenantId  Int       @map("tenant_id")
  firstName String    @map("first_name") @db.VarChar(100)
  lastName  String?   @map("last_name") @db.VarChar(100)
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  role      String    @default("operator") @db.VarChar(30)
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  sessions         UserSession[]
  tenant           Tenant                @relation(fields: [tenantId], references: [id])
  createdTemplates CardTemplate[]        @relation("TemplateCreatedBy")
  createdVersions  CardTemplateVersion[] @relation("VersionCreatedBy")
  issuedCards      IssuedCard[]          @relation("CardIssuedBy")

  @@map("users")
}

model UserSession {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model Tenant {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(150)
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  users                  User[]
  organizations          Organization[]
  attachments            Attachment[]
  people                 Person[]
  membershipTypes        MembershipType[]
  memberships            OrganizationMembership[]
  customFieldDefinitions CustomFieldDefinition[]
  cardTemplates          CardTemplate[]

  @@map("tenants")
}

model OrganizationType {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)
  code String @unique @db.VarChar(40)

  organizations Organization[]

  @@map("organization_types")
}

model Organization {
  id                 Int       @id @default(autoincrement())
  tenantId           Int       @map("tenant_id")
  name               String    @db.VarChar(200)
  organizationTypeId Int       @map("organization_type_id")
  attachmentId       Int?      @map("attachment_id")
  addressId          Int?      @map("address_id")
  email              String?   @db.VarChar(255)
  phone              String?   @db.VarChar(30)
  code               String?   @db.VarChar(60)
  status             String    @default("active") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @map("updated_at") @db.Timestamptz(6)

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])
  organizationType       OrganizationType         @relation(fields: [organizationTypeId], references: [id])
  attachment             Attachment?              @relation("OrganizationAttachment", fields: [attachmentId], references: [id])
  address                Address?                 @relation("OrganizationAddress", fields: [addressId], references: [id])
  contactPersons         ContactPerson[]
  memberships            OrganizationMembership[]
  customFieldDefinitions CustomFieldDefinition[]
  cardTemplates          CardTemplate[]

  @@unique([tenantId, code])
  @@map("organizations")
}

model ContactPerson {
  id             Int       @id @default(autoincrement())
  fullName       String    @map("full_name") @db.VarChar(200)
  organizationId Int       @map("organization_id")
  personId       Int?      @map("person_id")
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(30)
  addressId      Int?      @map("address_id")
  jobTitle       String?   @map("job_title") @db.VarChar(100)
  isPrimary      Boolean   @default(false) @map("is_primary")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id])
  person       Person?      @relation(fields: [personId], references: [id])
  address      Address?     @relation(fields: [addressId], references: [id])

  @@unique([organizationId, personId])
  @@map("contact_persons")
}

model Address {
  id           Int       @id @default(autoincrement())
  addressLine1 String?   @map("address_line_1") @db.VarChar(255)
  locality     String?   @db.VarChar(150)
  city         String?   @db.VarChar(100)
  stateId      Int?      @map("state_id")
  countryId    Int?      @map("country_id")
  postalCode   String?   @map("postal_code") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)

  state          State?          @relation(fields: [stateId], references: [id])
  country        Country?        @relation(fields: [countryId], references: [id])
  organizations  Organization[]  @relation("OrganizationAddress")
  contactPersons ContactPerson[]
  people         Person[]

  @@map("addresses")
}

model Country {
  id   Int     @id @default(autoincrement())
  name String  @db.VarChar(100)
  iso2 String? @unique @db.Char(2)
  iso3 String? @unique @db.Char(3)

  states    State[]
  addresses Address[]

  @@map("countries")
}

model State {
  id        Int     @id @default(autoincrement())
  countryId Int     @map("country_id")
  name      String  @db.VarChar(100)
  code      String? @db.VarChar(20)

  country   Country   @relation(fields: [countryId], references: [id])
  addresses Address[]

  @@unique([countryId, code])
  @@map("states")
}

model Attachment {
  id               Int      @id @default(autoincrement())
  tenantId         Int      @map("tenant_id")
  path             String   @db.Text
  url              String?  @db.Text
  originalFilename String?  @map("original_filename") @db.VarChar(255)
  mimeType         String?  @map("mime_type") @db.VarChar(100)
  sizeBytes        BigInt?  @map("size_bytes")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  organizationLogos  Organization[] @relation("OrganizationAttachment")
  personPhotos       Person[]       @relation("PersonPhoto")
  printedCardOutputs IssuedCard[]   @relation("PrintedCardOutput")

  @@map("attachments")
}

model Person {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @map("tenant_id")
  firstName         String    @map("first_name") @db.VarChar(100)
  middleName        String?   @map("middle_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  displayName       String?   @map("display_name") @db.VarChar(200)
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  email             String?   @db.VarChar(255)
  phone             String?   @db.VarChar(30)
  photoAttachmentId Int?      @map("photo_attachment_id")
  addressId         Int?      @map("address_id")
  status            String    @default("active") @db.VarChar(20)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  photoAttachment Attachment?              @relation("PersonPhoto", fields: [photoAttachmentId], references: [id])
  address         Address?                 @relation(fields: [addressId], references: [id])
  contactPersons  ContactPerson[]
  memberships     OrganizationMembership[]

  @@map("people")
}

model MembershipType {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])
  memberships            OrganizationMembership[]
  customFieldDefinitions CustomFieldDefinition[]
  cardTemplates          CardTemplate[]

  @@unique([tenantId, code])
  @@map("membership_types")
}

model OrganizationMembership {
  id                 Int       @id @default(autoincrement())
  tenantId           Int       @map("tenant_id")
  organizationId     Int       @map("organization_id")
  personId           Int       @map("person_id")
  membershipTypeId   Int       @map("membership_type_id")
  externalIdentifier String?   @map("external_identifier") @db.VarChar(100)
  status             String    @default("active") @db.VarChar(20)
  validFrom          DateTime? @map("valid_from") @db.Date
  validUntil         DateTime? @map("valid_until") @db.Date
  customData         Json      @default("{}") @map("custom_data") @db.JsonB
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  person         Person         @relation(fields: [personId], references: [id])
  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id])
  issuedCards    IssuedCard[]

  @@index([personId, organizationId])
  @@map("organization_memberships")
}

model CustomFieldDefinition {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @map("tenant_id")
  organizationId   Int       @map("organization_id")
  membershipTypeId Int       @map("membership_type_id")
  fieldKey         String    @map("field_key") @db.VarChar(80)
  label            String    @db.VarChar(100)
  dataType         String    @map("data_type") @db.VarChar(30)
  isRequired       Boolean   @default(false) @map("is_required")
  isSearchable     Boolean   @default(false) @map("is_searchable")
  options          Json?     @db.JsonB
  validationRules  Json?     @map("validation_rules") @db.JsonB
  sortOrder        Int       @default(0) @map("sort_order")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  membershipType MembershipType @relation(fields: [membershipTypeId], references: [id])

  @@unique([organizationId, membershipTypeId, fieldKey])
  @@map("custom_field_definitions")
}

model CardTemplate {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @map("tenant_id")
  organizationId   Int?      @map("organization_id")
  membershipTypeId Int?      @map("membership_type_id")
  name             String    @db.VarChar(150)
  description      String?   @db.Text
  status           String    @default("active") @db.VarChar(20)
  createdByUserId  Int?      @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  organization   Organization?         @relation(fields: [organizationId], references: [id])
  membershipType MembershipType?       @relation(fields: [membershipTypeId], references: [id])
  createdBy      User?                 @relation("TemplateCreatedBy", fields: [createdByUserId], references: [id])
  versions       CardTemplateVersion[]

  @@map("card_templates")
}

model CardTemplateVersion {
  id              Int       @id @default(autoincrement())
  templateId      Int       @map("template_id")
  versionNumber   Int       @map("version_number")
  widthMm         Decimal   @map("width_mm") @db.Decimal(7, 2)
  heightMm        Decimal   @map("height_mm") @db.Decimal(7, 2)
  frontLayout     Json      @map("front_layout") @db.JsonB
  backLayout      Json?     @map("back_layout") @db.JsonB
  status          String    @default("draft") @db.VarChar(20)
  createdByUserId Int?      @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)

  template    CardTemplate @relation(fields: [templateId], references: [id])
  createdBy   User?        @relation("VersionCreatedBy", fields: [createdByUserId], references: [id])
  issuedCards IssuedCard[]

  @@unique([templateId, versionNumber])
  @@map("card_template_versions")
}

model IssuedCard {
  id                        Int       @id @default(autoincrement())
  organizationMembershipId  Int       @map("organization_membership_id")
  templateVersionId         Int       @map("template_version_id")
  cardNumber                String    @unique @map("card_number") @db.VarChar(100)
  status                    String    @default("active") @db.VarChar(20)
  issuedAt                  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt                 DateTime? @map("expires_at") @db.Timestamptz(6)
  snapshotData              Json      @map("snapshot_data") @db.JsonB
  printedOutputAttachmentId Int?      @map("printed_output_attachment_id")
  issuedByUserId            Int?      @map("issued_by_user_id")
  replacesCardId            Int?      @map("replaces_card_id")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  membership       OrganizationMembership @relation(fields: [organizationMembershipId], references: [id])
  templateVersion  CardTemplateVersion    @relation(fields: [templateVersionId], references: [id])
  printedOutput    Attachment?            @relation("PrintedCardOutput", fields: [printedOutputAttachmentId], references: [id])
  issuedBy         User?                  @relation("CardIssuedBy", fields: [issuedByUserId], references: [id])
  replacesCard     IssuedCard?            @relation("CardReplacement", fields: [replacesCardId], references: [id])
  replacementCards IssuedCard[]           @relation("CardReplacement")

  @@index([organizationMembershipId, issuedAt])
  @@map("issued_cards")
}
